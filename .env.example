# ClickUp Agent Flow — provide these when ready to run.

# ClickUp API token (Settings → Apps → API Token)
# CLICKUP_API_TOKEN=pk_96660706_L41644O2Z5Y65KTHV1VVOPYGKJ1XPB4M

# Telegram bot token (@BotFather) and chat/channel ID
# TELEGRAM_BOT_TOKEN=8646458553:AAES0RHL-_eSkvZb1_HPCmuq9cR2JYQ1VRk
# TELEGRAM_CHAT_ID=-5395889011

# Repo: if every task specifies repo in description (repo: / github: / gitlab:), leave these unset.
# Only set when you want a fallback for tasks that don't include a repo line.
# GIT_PROVIDER=gitlab
# TARGET_REPO_URL=https://github.com/owner/repo.git

# --- GitHub (needed if any task uses a GitHub repo) ---
# GITHUB_TOKEN=ghp_xxxx
# GITHUB_REPO=owner/repo   # fallback only when repo not in task description

# --- GitLab (needed if any task uses a GitLab repo) ---
# GITLAB_TOKEN=glpat-xxxx
# GITLAB_PROJECT=group/repo   # fallback only when repo not in task description
# GITLAB_BASE_URL=https://gitlab.com

# Optional: common repo for agent context (memory / general MD)
# COMMON_REPO_URL=https://gitlab.com/anti_metter/switching_common

# --- LLM (Groq and/or OpenAI). If set, agent uses LLM for commit message + plan. ---
# Prefer Groq when both are set (or set AGENT_LLM_PROVIDER=openai to force OpenAI).
# AGENT_LLM_PROVIDER=groq
# GROQ_API_KEY=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
# GROQ_MODEL=llama-3.3-70b-versatile

# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o-mini

# Optional
# AGENTFLOW_IN_PROGRESS_STATUS=in progress
# AGENTFLOW_BASE_BRANCH=develop
# AGENTFLOW_WORK_DIR=./agentflow-workspace
# AGENTFLOW_PORT=8081
